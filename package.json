{
  "name": "embedforge",
  "version": "0.5.0",
  "description": "AI embedded development agent with senior-engineer skills, agentic file tools and code review. 嵌入式 AI 开发 Agent：描述需求，生成完整工程文件；内置资深工程师技能库与 Agent 文件工具。",
  "type": "module",
  "bin": {
    "embedforge": "dist/cli/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "skills"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "embedded",
    "embedded-systems",
    "ai-agent",
    "llm",
    "stm32",
    "esp32",
    "arduino",
    "code-generation",
    "openai-compatible",
    "typescript",
    "cli",
    "local-first",
    "skills",
    "agent",
    "tool-calling",
    "code-review"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
